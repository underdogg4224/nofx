# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# ========================================
# 🔧 APPLICATION CONFIGURATION
# ========================================

# Ports Configuration
# Backend API server port (internal: 8080, external: configurable)
NOFX_BACKEND_PORT=8080

# Frontend web interface port (Nginx listens on port 80 internally)
NOFX_FRONTEND_PORT=3000

# Timezone Setting
# System timezone for container time synchronization
NOFX_TIMEZONE=Asia/Shanghai

# ========================================
# 🔐 SECURITY CONFIGURATION (CRITICAL)
# ========================================

# Master secret for encrypting API keys and sensitive data
# REQUIRED for production deployment
# Generate with: openssl rand -base64 48
NOFX_ENCRYPTION_SECRET=your-strong-random-secret-min-32-chars-here

# Alternatively, use a file for the encryption secret
# NOFX_ENCRYPTION_SECRET_FILE=/path/to/secret/file

# JWT secret for token signing
# RECOMMENDED: Set a strong random value in production
# Generate with: openssl rand -hex 64
JWT_SECRET=your-jwt-secret-key-change-in-production-make-it-long-and-random

# ========================================
# 🌐 CORS CONFIGURATION
# ========================================

# Allowed origins for CORS (comma-separated)
# For production: Only whitelist your actual domain(s)
# For development: Can include localhost
NOFX_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,*

# Production example:
# NOFX_ALLOWED_ORIGINS=https://trade.yourdomain.com,https://app.yourdomain.com

# WARNING: Remove "*" from NOFX_ALLOWED_ORIGINS in production!

# ========================================
# 📊 SECURITY LOGGING
# ========================================

# Enable security event logging (recommended: true)
NOFX_SECURITY_LOGGING=true

# Security log file path
# SECURITY_LOG_PATH=logs/security.log

# ========================================
# 💡 USAGE INSTRUCTIONS
# ========================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Generate strong secrets:
#    openssl rand -base64 48  # For NOFX_ENCRYPTION_SECRET
#    openssl rand -hex 64     # For JWT_SECRET

# 3. Update .env file with generated values

# 4. Set proper file permissions:
#    chmod 600 .env

# 5. Never commit .env to version control

# ========================================
# 📚 RESOURCES
# ========================================

